{
  "name": "ScrapeBook",
  "description": "A lightweight Facebook post browsing and scraping automation tool.",
  "version": "0.1.0",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/facebook.png",
    "48": "icons/facebook.png",
    "128": "icons/facebook.png"
  },
  "action": {
    "default_title": "ScrapeBook",
    "default_icon": {
      "16": "icons/facebook.png",
      "48": "icons/facebook.png",
      "128": "icons/facebook.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://facebook.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}